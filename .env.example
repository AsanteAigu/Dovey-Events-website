# Copy to .env and fill in. Never commit .env.

PORT=3000
# The public address of the site. Paystack sends customers back here after paying.
PUBLIC_URL=http://localhost:3000

# Paystack: Dashboard -> Settings -> API Keys & Webhooks.
# Use sk_test_... while testing, sk_live_... when going live.
PAYSTACK_SECRET_KEY=

# Password for /admin, and a long random string used to sign admin sessions.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
SESSION_SECRET=

# Business rules
DEPOSIT_PERCENT=30
MAX_EVENTS_PER_DAY=2
MIN_LEAD_DAYS=7
HOLD_MINUTES=30

# Supabase: Project → Connect → Transaction pooler (port 6543). URL-encode special
# characters in the password (a space becomes %20). Leave empty to use a local
# database for development.
DATABASE_URL=
